[gd_resource type="Resource" script_class="EventData" format=3 load_steps=6]

[ext_resource type="Script" path="res://data/models/event_data.gd" id="1"]
[ext_resource type="Script" path="res://data/models/event_choice_data.gd" id="2"]

[sub_resource type="Resource" id="Choice_0"]
script = ExtResource("2")
label_key = "event.dice.small"
result_key = "event.dice.small_result"
failure_key = "event.dice.lost"
wager_gold = 40
win_chance = 0.5
payout_multiplier = 2.0
requires_gold = 40

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2")
label_key = "event.dice.big"
result_key = "event.dice.big_result"
failure_key = "event.dice.lost"
wager_gold = 150
win_chance = 0.4
payout_multiplier = 2.6
requires_gold = 150

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2")
label_key = "event.dice.walk"
result_key = "event.dice.walk_result"

[resource]
script = ExtResource("1")
id = &"event.dice"
title_key = "event.dice.title"
body_key = "event.dice.body"
weight = 1.5
min_level = 3
choices = Array[ExtResource("2")]([SubResource("Choice_0"), SubResource("Choice_1"), SubResource("Choice_2")])
